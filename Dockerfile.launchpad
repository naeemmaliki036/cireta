FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat python3 make g++

# Stage 1: install deps
FROM base AS deps
WORKDIR /app
COPY package.json ./
COPY apps/launchpad/package.json ./apps/launchpad/
COPY apps/admin/package.json ./apps/admin/
RUN mkdir -p contracts subgraph && \
    echo '{"name":"contracts","version":"1.0.0"}' > contracts/package.json && \
    echo '{"name":"cireta-subgraph","version":"1.0.0"}' > subgraph/package.json
RUN npm install --legacy-peer-deps

# Stage 2: build launchpad
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ARG NEXT_PUBLIC_API_URL=https://api.up.railway.app
ARG NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=placeholder
ARG NEXT_PUBLIC_CHAIN_ID=84532
ARG NEXT_PUBLIC_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
ARG NEXT_PUBLIC_SALE_FACTORY_ADDRESS
ARG NEXT_PUBLIC_TOKEN_FACTORY_ADDRESS
ARG NEXT_PUBLIC_IDENTITY_REGISTRY_ADDRESS
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=$NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID
ENV NEXT_PUBLIC_CHAIN_ID=$NEXT_PUBLIC_CHAIN_ID
ENV NEXT_PUBLIC_USDC_ADDRESS=$NEXT_PUBLIC_USDC_ADDRESS
ENV NEXT_PUBLIC_SALE_FACTORY_ADDRESS=$NEXT_PUBLIC_SALE_FACTORY_ADDRESS
ENV NEXT_PUBLIC_TOKEN_FACTORY_ADDRESS=$NEXT_PUBLIC_TOKEN_FACTORY_ADDRESS
ENV NEXT_PUBLIC_IDENTITY_REGISTRY_ADDRESS=$NEXT_PUBLIC_IDENTITY_REGISTRY_ADDRESS
RUN npm run build --workspace=apps/launchpad

# Stage 3: lean runner
FROM node:20-alpine AS runner
RUN apk add --no-cache python3
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME="0.0.0.0"
ENV PORT=3000

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

COPY --from=builder /app/apps/launchpad/public ./apps/launchpad/public
COPY --from=builder --chown=nextjs:nodejs /app/apps/launchpad/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/launchpad/.next/static ./apps/launchpad/.next/static

# Create start.py shim for Railway (it always runs "python start.py")
RUN echo 'import os,sys; print("Launchpad starting on port " + os.environ.get("PORT","3000"), flush=True); os.execvp("node", ["node", "apps/launchpad/server.js"])' > /app/start.py

USER nextjs
EXPOSE 3000
CMD ["node", "apps/launchpad/server.js"]
