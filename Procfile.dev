# Development process management with Honcho
# Usage: honcho start -f Procfile.dev

api: poetry run uvicorn apps.api.main:app --reload --host 0.0.0.0 --port 8000
worker: poetry run arq apps.api.workers.tasks.WorkerSettings
launchpad: npm run dev --workspace=apps/launchpad
admin: npm run dev --workspace=apps/admin
