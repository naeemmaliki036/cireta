# Stage 1: Dependencies
FROM python:3.11-slim AS deps
WORKDIR /app
RUN pip install poetry && poetry config virtualenvs.in-project true
COPY pyproject.toml poetry.lock* ./
RUN poetry install --no-root --no-interaction --no-ansi


# Stage 2: Runner
FROM python:3.11-slim AS runner
RUN useradd -m -r appuser
WORKDIR /app
COPY --from=deps /app/.venv /app/.venv

# Ensure venv is on PATH
ENV PATH="/app/.venv/bin:$PATH"
ENV VIRTUAL_ENV="/app/.venv"

# Explicitly copy application directories
COPY pyproject.toml /app/pyproject.toml
COPY apps /app/apps
COPY packages /app/packages
COPY infra /app/infra
COPY scripts /app/scripts
COPY .env.example /app/.env.example

# Verify alembic config and migrations are present
RUN test -f infra/alembic/alembic.ini && test -d infra/alembic/versions

USER appuser
EXPOSE 8000

# Start the API server
ENV PORT=8000
CMD sh -c "echo 'Starting Cireta API on port $PORT' && exec uvicorn apps.api.main:app --host 0.0.0.0 --port $PORT"
