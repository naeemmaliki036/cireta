FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat python3 make g++

# Stage 1: install deps
FROM base AS deps
WORKDIR /app
COPY package.json ./
COPY apps/launchpad/package.json ./apps/launchpad/
COPY apps/admin/package.json ./apps/admin/
RUN mkdir -p contracts subgraph && \
    echo '{"name":"contracts","version":"1.0.0"}' > contracts/package.json && \
    echo '{"name":"cireta-subgraph","version":"1.0.0"}' > subgraph/package.json
RUN npm install --legacy-peer-deps

# Stage 2: build admin
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# NEXT_PUBLIC_ vars must be present at build time for Next.js static optimization
ARG NEXT_PUBLIC_API_URL=https://api.up.railway.app
ARG NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=placeholder
ARG NEXT_PUBLIC_CHAIN_ID=84532
ARG NEXT_PUBLIC_RPC_URL=https://base-sepolia-rpc.publicnode.com
ARG NEXT_PUBLIC_ISSUER_REGISTRY_ADDRESS
ARG NEXT_PUBLIC_TOKEN_FACTORY_ADDRESS
ARG NEXT_PUBLIC_SALE_FACTORY_ADDRESS
ARG NEXT_PUBLIC_PLATFORM_FEE_MANAGER_ADDRESS
ARG NEXT_PUBLIC_CIRETA_USDC_ADDRESS
ARG NEXT_PUBLIC_IDENTITY_REGISTRY_ADDRESS
ARG NEXT_PUBLIC_OTC_TOKEN_FACTORY_ADDRESS
ARG NEXT_PUBLIC_COUNTRY_ALLOW_MODULE_ADDRESS
ARG NEXT_PUBLIC_MAX_HOLDER_COUNT_MODULE_ADDRESS
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=$NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID
ENV NEXT_PUBLIC_CHAIN_ID=$NEXT_PUBLIC_CHAIN_ID
ENV NEXT_PUBLIC_RPC_URL=$NEXT_PUBLIC_RPC_URL
ENV NEXT_PUBLIC_ISSUER_REGISTRY_ADDRESS=$NEXT_PUBLIC_ISSUER_REGISTRY_ADDRESS
ENV NEXT_PUBLIC_TOKEN_FACTORY_ADDRESS=$NEXT_PUBLIC_TOKEN_FACTORY_ADDRESS
ENV NEXT_PUBLIC_SALE_FACTORY_ADDRESS=$NEXT_PUBLIC_SALE_FACTORY_ADDRESS
ENV NEXT_PUBLIC_PLATFORM_FEE_MANAGER_ADDRESS=$NEXT_PUBLIC_PLATFORM_FEE_MANAGER_ADDRESS
ENV NEXT_PUBLIC_CIRETA_USDC_ADDRESS=$NEXT_PUBLIC_CIRETA_USDC_ADDRESS
ENV NEXT_PUBLIC_IDENTITY_REGISTRY_ADDRESS=$NEXT_PUBLIC_IDENTITY_REGISTRY_ADDRESS
ENV NEXT_PUBLIC_OTC_TOKEN_FACTORY_ADDRESS=$NEXT_PUBLIC_OTC_TOKEN_FACTORY_ADDRESS
ENV NEXT_PUBLIC_COUNTRY_ALLOW_MODULE_ADDRESS=$NEXT_PUBLIC_COUNTRY_ALLOW_MODULE_ADDRESS
ENV NEXT_PUBLIC_MAX_HOLDER_COUNT_MODULE_ADDRESS=$NEXT_PUBLIC_MAX_HOLDER_COUNT_MODULE_ADDRESS
RUN npm run build --workspace=apps/admin

# Stage 3: lean runner
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME="0.0.0.0"
# Forward NEXT_PUBLIC_ vars to runtime — Railway injects env vars at runtime,
# and Next.js standalone server reads them for server-side rendering + API routes
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID
ARG NEXT_PUBLIC_CHAIN_ID
ARG NEXT_PUBLIC_RPC_URL
ARG NEXT_PUBLIC_ISSUER_REGISTRY_ADDRESS
ARG NEXT_PUBLIC_TOKEN_FACTORY_ADDRESS
ARG NEXT_PUBLIC_SALE_FACTORY_ADDRESS
ARG NEXT_PUBLIC_PLATFORM_FEE_MANAGER_ADDRESS
ARG NEXT_PUBLIC_CIRETA_USDC_ADDRESS
ARG NEXT_PUBLIC_IDENTITY_REGISTRY_ADDRESS
ARG NEXT_PUBLIC_OTC_TOKEN_FACTORY_ADDRESS
ARG NEXT_PUBLIC_COUNTRY_ALLOW_MODULE_ADDRESS
ARG NEXT_PUBLIC_MAX_HOLDER_COUNT_MODULE_ADDRESS
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=$NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID
ENV NEXT_PUBLIC_CHAIN_ID=$NEXT_PUBLIC_CHAIN_ID
ENV NEXT_PUBLIC_RPC_URL=$NEXT_PUBLIC_RPC_URL
ENV NEXT_PUBLIC_ISSUER_REGISTRY_ADDRESS=$NEXT_PUBLIC_ISSUER_REGISTRY_ADDRESS
ENV NEXT_PUBLIC_TOKEN_FACTORY_ADDRESS=$NEXT_PUBLIC_TOKEN_FACTORY_ADDRESS
ENV NEXT_PUBLIC_SALE_FACTORY_ADDRESS=$NEXT_PUBLIC_SALE_FACTORY_ADDRESS
ENV NEXT_PUBLIC_PLATFORM_FEE_MANAGER_ADDRESS=$NEXT_PUBLIC_PLATFORM_FEE_MANAGER_ADDRESS
ENV NEXT_PUBLIC_CIRETA_USDC_ADDRESS=$NEXT_PUBLIC_CIRETA_USDC_ADDRESS
ENV NEXT_PUBLIC_IDENTITY_REGISTRY_ADDRESS=$NEXT_PUBLIC_IDENTITY_REGISTRY_ADDRESS
ENV NEXT_PUBLIC_OTC_TOKEN_FACTORY_ADDRESS=$NEXT_PUBLIC_OTC_TOKEN_FACTORY_ADDRESS
ENV NEXT_PUBLIC_COUNTRY_ALLOW_MODULE_ADDRESS=$NEXT_PUBLIC_COUNTRY_ALLOW_MODULE_ADDRESS
ENV NEXT_PUBLIC_MAX_HOLDER_COUNT_MODULE_ADDRESS=$NEXT_PUBLIC_MAX_HOLDER_COUNT_MODULE_ADDRESS

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

COPY --from=builder /app/apps/admin/public ./apps/admin/public
COPY --from=builder --chown=nextjs:nodejs /app/apps/admin/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/admin/.next/static ./apps/admin/.next/static

# Railway workaround: create start.py shim that launches Node.
# Railway's cached project config runs "python start.py" regardless of Custom
# Start Command. Alpine ships python3 only (no python symlink), so we add it.
RUN apk add --no-cache python3 && \
    ln -sf /usr/bin/python3 /usr/bin/python && \
    echo 'import os; os.execvp("node", ["node", "apps/admin/server.js"])' > /app/start.py

USER nextjs
ENTRYPOINT ["node", "apps/admin/server.js"]
