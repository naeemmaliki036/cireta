# Stage 1: Dependencies — same image as the api service so the venv is shared
FROM python:3.11-slim AS deps
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev && \
    rm -rf /var/lib/apt/lists/*
RUN pip install poetry && poetry config virtualenvs.in-project true
COPY pyproject.toml poetry.lock* ./
RUN poetry install --no-root --no-interaction --no-ansi


# Stage 2: Runner — runs the arq worker, NO uvicorn / no HTTP listener
FROM python:3.11-slim AS runner
WORKDIR /app

# Runtime system deps (libpq for asyncpg, libffi for cryptography)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 libffi8 && \
    rm -rf /var/lib/apt/lists/*

COPY --from=deps /app/.venv /app/.venv

ENV PATH="/app/.venv/bin:$PATH"
ENV VIRTUAL_ENV="/app/.venv"
ENV PYTHONUNBUFFERED=1

# Copy application code (same layout as api so the imports resolve identically)
COPY pyproject.toml /app/pyproject.toml
COPY apps /app/apps
COPY packages /app/packages
COPY infra /app/infra
COPY scripts /app/scripts

# Verify ONLY third-party deps at build time (can't import app modules
# here because Pydantic Settings() validation needs env vars that are
# only injected at runtime). The real module import happens inside
# scripts/start_worker.py on container boot, which is gated by a
# friendly preflight check that fails fast on missing env vars.
RUN python -c "import arq; from arq.connections import RedisSettings; import asyncpg, sqlalchemy, web3; print('worker base deps OK')"

# No EXPOSE — the worker has no HTTP listener. Railway should set the
# service type to "worker" (no public domain, no health check).

CMD ["python", "scripts/start_worker.py"]
