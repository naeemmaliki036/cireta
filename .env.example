# Root Environment Configuration for Cireta RWA Launchpad
# Copy to .env and customize

# Application
ENVIRONMENT=development  # development | staging | production

# Database (asyncpg for async support)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cireta

# Redis
REDIS_URL=redis://localhost:6379/0

# Security (required in production)
JWT_SECRET_KEY=
ENCRYPTION_KEY=

# Logging
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://launchpad.cireta.com,https://admin.cireta.com

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Web3 / Blockchain
CHAIN_ID=8453
WEB3_RPC_URL=https://mainnet.base.org
DEPLOYER_PRIVATE_KEY=
PLATFORM_FEE_RECEIVER=0xBE84C7a8f44F673173d51C0A212C9C66267066A0

# ONCHAINID
IDENTITY_FACTORY_ADDRESS=
IDENTITY_REGISTRY_ADDRESS=

# Sumsub KYC
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=

# External Services
PINATA_API_KEY=
PINATA_SECRET_KEY=
RESEND_API_KEY=

# Wallet Screening
# Chainalysis or Elliptic API key for wallet sanctions screening
SCREENING_API_KEY=

# Identity Mode: "simple" (whitelist) or "erc3643" (full ONCHAINID)
IDENTITY_MODE=simple

# ONCHAINID (only needed for erc3643 mode)
CLAIM_SIGNER_PRIVATE_KEY=
CLAIM_ISSUER_ADDRESS=

# Max wallets per investor
MAX_WALLETS_PER_INVESTOR=10

# GCS File Storage (leave blank for local fallback in dev)
GCS_BUCKET=                    # public bucket: images, videos, banners
GCS_PRIVATE_BUCKET=            # private bucket: whitepapers, legal docs
GCS_PROJECT_ID=
GCS_CREDENTIALS_FILE=          # path to service account JSON key
# OR inline: GCS_CREDENTIALS_JSON={"type":"service_account",...}

# Google OAuth (launchpad SSO only — leave blank to hide Google button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
