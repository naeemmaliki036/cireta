# Root Environment Configuration for Cireta RWA Launchpad
# Copy to .env and customize

# Application
ENVIRONMENT=development  # development | staging | production

# Database (asyncpg for async support)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cireta

# Redis
REDIS_URL=redis://localhost:6379/0

# Security (required in production)
JWT_SECRET_KEY=
ENCRYPTION_KEY=

# Logging
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://launchpad.cireta.com,https://admin.cireta.com

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Web3 / Blockchain
CHAIN_ID=8453
WEB3_RPC_URL=https://mainnet.base.org
DEPLOYER_PRIVATE_KEY=
PLATFORM_FEE_RECEIVER=0xBE84C7a8f44F673173d51C0A212C9C66267066A0

# ONCHAINID
IDENTITY_FACTORY_ADDRESS=
IDENTITY_REGISTRY_ADDRESS=

# Sumsub KYC
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=

# External Services
PINATA_API_KEY=
PINATA_SECRET_KEY=
RESEND_API_KEY=

# Wallet Screening
# Chainalysis or Elliptic API key for wallet sanctions screening
SCREENING_API_KEY=
