# Backend Environment Configuration for Cireta RWA Launchpad
# Copy to .env.backend and customize

# =============================================================================
# REQUIRED IN PRODUCTION
# =============================================================================

# Database connection string (asyncpg for async support)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cireta

# JWT secret for token signing (min 32 characters)
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production

# Encryption key for sensitive fields (Fernet key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Sumsub KYC credentials
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Environment: development | staging | production
ENVIRONMENT=development

# Debug mode (disable in production)
DEBUG=true

# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://launchpad.cireta.com,https://admin.cireta.com

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# API server host and port
API_HOST=0.0.0.0
API_PORT=8000

# Number of worker processes (production)
WORKERS=4

# =============================================================================
# DATABASE SETTINGS
# =============================================================================

# Connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=300

# =============================================================================
# REDIS
# =============================================================================

# Redis connection string
REDIS_URL=redis://localhost:6379/0

# Cache TTL in seconds
CACHE_TTL=3600

# =============================================================================
# AUTHENTICATION
# =============================================================================

# JWT token expiration (seconds)
ACCESS_TOKEN_EXPIRE_SECONDS=900   # 15 minutes
REFRESH_TOKEN_EXPIRE_SECONDS=604800  # 7 days

# Password hashing rounds
BCRYPT_ROUNDS=12

# =============================================================================
# RATE LIMITING (requests per minute)
# =============================================================================

RATE_LIMIT_DEFAULT=100
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=10
RATE_LIMIT_CONTRIBUTE=20

# =============================================================================
# WEB3 / BLOCKCHAIN (Base Mainnet)
# =============================================================================

CHAIN_ID=8453
WEB3_RPC_URL=https://mainnet.base.org

# Deployer wallet private key (from ~/.ferron/x402-server-wallet.json)
IDENTITY_SIGNER_PRIVATE_KEY=

# Platform fee receiver address
PLATFORM_FEE_RECEIVER=0xBE84C7a8f44F673173d51C0A212C9C66267066A0

# =============================================================================
# KYC SETTINGS
# =============================================================================

KYC_MIN_LEVEL_INVEST=2
KYC_MIN_LEVEL_INITIATE=1

# =============================================================================
# PLATFORM SETTINGS
# =============================================================================

PLATFORM_FEE_BPS=200  # 2% default fee

# =============================================================================
# LOGGING
# =============================================================================

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Log format: json | console
LOG_FORMAT=console

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Sumsub KYC
SUMSUB_BASE_URL=https://api.sumsub.com

# Pinata IPFS
PINATA_API_KEY=
PINATA_SECRET_KEY=

# Resend Email
RESEND_API_KEY=
SMTP_FROM=noreply@cireta.com

# =============================================================================
# IDENTITY MODE
# =============================================================================

# "simple" = whitelist registry, "erc3643" = full ONCHAINID + claims
IDENTITY_MODE=simple
CLAIM_SIGNER_PRIVATE_KEY=
CLAIM_ISSUER_ADDRESS=
MAX_WALLETS_PER_INVESTOR=10

# =============================================================================
# FILE STORAGE (GCS)
# =============================================================================

# Public bucket: images, videos, banners (direct public URLs)
GCS_BUCKET=
# Private bucket: whitepapers, legal docs (signed URLs with expiry)
GCS_PRIVATE_BUCKET=
GCS_PROJECT_ID=
# Path to service account JSON key file
GCS_CREDENTIALS_FILE=
# OR inline JSON credentials (alternative to file):
# GCS_CREDENTIALS_JSON=

# =============================================================================
# GOOGLE OAUTH (launchpad SSO only)
# =============================================================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
