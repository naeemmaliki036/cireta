# Backend Environment Configuration
# Copy to .env.backend and customize

# =============================================================================
# REQUIRED IN PRODUCTION
# =============================================================================

# Database connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scaffold

# JWT secret for token signing (min 32 characters)
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production

# Encryption key for sensitive fields (32 bytes, base64 encoded)
# Generate with: python -c "import secrets; import base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Environment: development | staging | production
ENVIRONMENT=development

# Debug mode (disable in production)
DEBUG=true

# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# API server host and port
API_HOST=0.0.0.0
API_PORT=8000

# Number of worker processes (production)
WORKERS=4

# =============================================================================
# DATABASE SETTINGS
# =============================================================================

# Connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=300

# =============================================================================
# REDIS (OPTIONAL)
# =============================================================================

# Redis connection string
REDIS_URL=redis://localhost:6379/0

# Cache TTL in seconds
CACHE_TTL=3600

# =============================================================================
# AUTHENTICATION
# =============================================================================

# JWT token expiration (seconds)
ACCESS_TOKEN_EXPIRE_SECONDS=3600
REFRESH_TOKEN_EXPIRE_SECONDS=604800

# Password hashing rounds
BCRYPT_ROUNDS=12

# =============================================================================
# LOGGING
# =============================================================================

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Log format: json | console
LOG_FORMAT=console

# =============================================================================
# EXTERNAL SERVICES (OPTIONAL)
# =============================================================================

# Email service
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Object storage
# S3_BUCKET=
# S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
