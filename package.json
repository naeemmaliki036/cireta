{
  "name": "cireta",
  "version": "1.0.0",
  "private": true,
  "description": "Cireta RWA Launchpad - Regulated commodity tokenization on Base L2",
  "scripts": {
    "dev": "poetry run honcho start -f Procfile.dev",
    "dev:launchpad": "pnpm --filter launchpad dev",
    "dev:admin": "pnpm --filter admin dev",
    "dev:api": "poetry run uvicorn apps.api.main:app --reload --host 0.0.0.0 --port 3010",
    "build": "turbo run build",
    "build:launchpad": "pnpm --filter launchpad build",
    "build:admin": "pnpm --filter admin build",
    "build:contracts": "pnpm --filter contracts compile",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:api": "poetry run pytest",
    "test:contracts": "pnpm --filter contracts test",
    "test:e2e": "bash e2e-tests/run-all.sh",
    "test:flow": "pnpm exec playwright test --project=api-flow",
    "test:ui": "pnpm exec playwright test --project=ui-launchpad --project=ui-admin",
    "test:playwright": "pnpm exec playwright test",
    "format": "pnpm -r format && poetry run ruff format .",
    "format:check": "poetry run ruff format --check .",
    "clean": "turbo run clean"
  },
  "workspaces": [
    "apps/*",
    "contracts",
    "subgraph"
  ],
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "concurrently": "^9.1.0",
    "pino-pretty": "^13.1.3",
    "turbo": "^2.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
